# 复制为 .env 并填入你的配置
# cp .env.example .env

# Flask 密钥(生产环境务必换成随机值)
SECRET_KEY=dev-only-key

# --- Embedding 服务:智谱(ZhipuAI)---
# key 在 https://open.bigmodel.cn/ 获取,格式为 xxx.xxx(必填)
EMBEDDING_API_KEY=your-zhipu-api-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# --- Chat 服务:OpenCode Zen(OpenAI 兼容)---
# 端点公开访问,无需真实 key,任意非空值即可
CHAT_API_KEY=opencode-zen
CHAT_BASE_URL=https://opencode.ai/zen/go/v1
CHAT_MODEL=deepseek-v4-flash
